# Application Configuration
APP_ENV=development
APP_PORT=3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-here-different-from-main
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=super_admin
DB_PASSWORD=superadmin
DB_DATABASE=lets_form_a_team
DB_SYNC=true
DB_DEBUG=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# API Security
X_API_KEY=your-api-key-here
X_API_ACCEPT_TTL=30000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Super Admin Configuration
SUPER_ADMIN_PASSWORD=secure_super_admin_password_here 