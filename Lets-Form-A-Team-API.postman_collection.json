                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"superAdmin\",\n  \"password\": \"testPassword123!\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
